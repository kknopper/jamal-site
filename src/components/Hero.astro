---
import { site } from '../site';
import Logo from './Logo.astro';

const { reel, nav } = site;
---

<header class="hero">
  <div class="hero-media" aria-hidden="true">
    {
      reel.loop ? (
        <video
          class="hero-video"
          src={reel.loop}
          poster={reel.poster || undefined}
          autoplay
          muted
          loop
          playsinline
          disablepictureinpicture
          data-hero-video
        />
      ) : (
        <span class="hero-placeholder">SHOWREEL 2026 · autoplay, muted, loop</span>
      )
    }
  </div>

  <div class="nav-row">
    <Logo />

    <nav class="nav-links d-only" aria-label="Primary">
      {nav.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <button class="menu-btn m-only" popovertarget="mobile-menu" aria-label="Menu">
      <svg class="burger" viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"
        ><rect class="bar top" x="0" y="4" width="18" height="2"></rect
        ><rect class="bar bottom" x="0" y="12" width="18" height="2"></rect
      ></svg>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-menu" popover aria-label="Primary">
    <div class="mobile-menu-top">
      <Logo href={null} />
      <!-- Sits exactly over the hamburger button, so the bars appear to turn into this X. -->
      <button class="menu-btn menu-close" popovertarget="mobile-menu" popovertargetaction="hide" aria-label="Close menu">
        <svg class="burger" viewBox="0 0 18 18" width="18" height="18" aria-hidden="true"
          ><rect class="bar top" x="0" y="4" width="18" height="2"></rect
          ><rect class="bar bottom" x="0" y="12" width="18" height="2"></rect
        ></svg>
      </button>
    </div>
    <ul>
      {nav.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
  </nav>

  <div class="hero-bottom">
    <div class="hero-copy">
      <span class="eyebrow">{site.eyebrow}</span>
      <h1>Video editor.<br />Hours of footage.<br />Minutes that matter.</h1>
    </div>
    <a class="btn-pill hero-cta" href={reel.full} data-video data-video-title="Showreel 2026">
      <span class="play" aria-hidden="true"></span>Play reel with sound
    </a>
  </div>
</header>

<script>
  // Respect reduced motion: stop the background reel on its poster frame.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const sync = () => {
    if (!video) return;
    if (reduce.matches) video.pause();
    else video.play().catch(() => {});
  };
  sync();
  reduce.addEventListener('change', sync);

  // Close the mobile menu after picking a link.
  const menu = document.getElementById('mobile-menu');
  menu?.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) menu.hidePopover();
  });
</script>

<style>
  .hero {
    position: relative;
    height: 88vh;
    min-height: 520px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    background: repeating-linear-gradient(
      135deg,
      var(--stripe-a) 0 14px,
      var(--stripe-b) 14px 28px
    );
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    pointer-events: none;
  }
  .hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Keeps the headline readable over bright footage. */
  .hero-media:has(video)::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgb(14 14 13 / 0.9) 0%,
      rgb(14 14 13 / 0.5) 45%,
      rgb(14 14 13 / 0.45) 75%,
      rgb(14 14 13 / 0.7) 100%
    );
  }
  .hero-placeholder {
    font: 12px var(--mono);
    color: var(--faint);
  }

  .nav-row {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 28px var(--gutter);
    font-size: 14px;
    letter-spacing: 0.02em;
  }
  .nav-links {
    display: flex;
    gap: 32px;
  }
  .nav-links a {
    color: var(--text-2);
  }
  .nav-links a:hover {
    color: var(--accent);
  }

  .menu-btn {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    padding: 0;
    background: none;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    color: var(--text);
    cursor: pointer;
  }
  /* Hover only where there's a real pointer: on phones :hover sticks after a tap. */
  @media (hover: hover) {
    .menu-btn:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
  }

  /* Hamburger ⇄ X: the same two 18×2 bars. For the X, each bar moves to the
     middle and turns 45°, rotating around its own centre (transform-box). */
  .burger {
    display: block;
    overflow: visible;
  }
  .bar {
    fill: currentColor;
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.35s cubic-bezier(0.3, 0.7, 0.1, 1);
  }
  .menu-close .top,
  :global(html:has(#mobile-menu:popover-open)) .menu-btn .top {
    transform: translateY(4px) rotate(45deg);
  }
  .menu-close .bottom,
  :global(html:has(#mobile-menu:popover-open)) .menu-btn .bottom {
    transform: translateY(-4px) rotate(-45deg);
  }
  /* Opening: the X inside the menu starts as bars and animates to an X.
     Closing: the menu fades out while the hamburger underneath (already an X)
     animates back to bars. */
  @starting-style {
    .mobile-menu:popover-open .menu-close .bar {
      transform: none;
    }
  }

  .mobile-menu {
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 20px;
    border: none;
    background: var(--bg);
    color: var(--text);
    font-size: 14px;
    opacity: 0;
    transition:
      opacity 0.25s,
      overlay 0.25s allow-discrete,
      display 0.25s allow-discrete;
  }
  .mobile-menu:popover-open {
    opacity: 1;
  }
  @starting-style {
    .mobile-menu:popover-open {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu,
    .bar {
      transition: none;
    }
  }
  .mobile-menu-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  /* SVG bars, not the "×" character: a glyph sits wherever the font puts it,
     so it never centres exactly; drawn bars are centred by geometry. */
  .mobile-menu ul {
    list-style: none;
    margin: 64px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .mobile-menu li a {
    font-size: 44px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .hero-bottom {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 28px;
    padding: clamp(28px, 4vw, 48px) var(--gutter);
  }
  .hero-copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .eyebrow {
    font: 13px var(--mono);
    color: var(--text-2);
  }
  h1 {
    font-weight: 900;
    font-size: clamp(64px, 8vw, 120px);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }
  .hero-cta {
    flex: none;
    gap: 12px;
    padding: 16px 26px;
    font-size: 15px;
  }
  .hero-cta .play {
    border-left-width: 10px;
    border-top-width: 6px;
    border-bottom-width: 6px;
  }

  @media (width < 760px) {
    .hero {
      height: 82vh;
    }
    .nav-row {
      padding: 20px;
    }
    .hero-bottom {
      padding: 24px 20px 32px;
    }
    h1 {
      font-size: 52px;
    }
  }
</style>
