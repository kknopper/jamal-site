---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import WorkTimeline from '../components/WorkTimeline.astro';
import About from '../components/About.astro';
import Footer from '../components/Footer.astro';
import VideoDialog from '../components/VideoDialog.astro';
import ContactDialog from '../components/ContactDialog.astro';
import { site } from '../site';

// Tells search engines who the site is about. Placeholder social links ('#')
// are left out until real ones are added in src/site.ts.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'Video editor',
  description: site.description,
  url: Astro.site?.href,
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Las Vegas', addressRegion: 'NV', addressCountry: 'US' },
  sameAs: site.social.map((s) => s.href).filter((h) => h.startsWith('http')),
};
---

<Base>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(person)} />
  <div class="page">
    <Hero />
    <main>
      <WorkTimeline />
      <About />
    </main>
    <Footer />
  </div>
  <VideoDialog />
  <ContactDialog />
</Base>

<style>
  .page {
    max-width: 1440px;
    margin: 0 auto;
  }
</style>
